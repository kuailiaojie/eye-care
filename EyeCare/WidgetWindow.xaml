<Window
    x:Class="EyeCare.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          DoubleTapped="RootGrid_DoubleTapped"
          ToolTipService.ToolTip="双击打开护眼助手 · 拖动可移动位置">
        <Border x:Name="CardBorder"
                Background="{ThemeResource AcrylicInAppBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
            <StackPanel Spacing="8">
                <!-- 状态行：状态点 + 状态文字 + 蓝光过滤胶囊 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="工作中"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="BlueLightText" Text="蓝光过滤 开"
                                   FontSize="10"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </Grid>

                <!-- 使用时长 -->
                <TextBlock x:Name="TimeText" Text="已工作 0 分钟"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                <!-- 进度条 -->
                <ProgressBar x:Name="WorkProgress" Height="4" Minimum="0" Maximum="100"
                             Value="0" VerticalAlignment="Center"/>

                <!-- 底部：剩余时间 + 操作提示 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailText" Text="距离休息还有 20 分钟"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="🖱 拖动 · 双击打开" FontSize="10"
                               Opacity="0.6"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap3 rescap com desktop">

  <!--
    Microsoft Store 正式身份（Partner Center 分配，请勿手动修改）：
    Name / Identity     DE3C23BA.666688A021C8
    Publisher           CN=AAC205F6-41D2-4FAD-8218-4E47E5D84363
    PublisherDisplayName 块了解
    PFN                 DE3C23BA.666688A021C8_p7a589d6fj0mw
    Store ID            9N57F4STPJQD
    Store 链接           https://apps.microsoft.com/detail/9N57F4STPJQD
  -->
  <Identity
    Name="DE3C23BA.666688A021C8"
    Publisher="CN=AAC205F6-41D2-4FAD-8218-4E47E5D84363"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>护眼助手</DisplayName>
    <PublisherDisplayName>块了解</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="zh-cn" />
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Applications>
    <Application Id="App"
      Executable="EyeCare.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="护眼助手"
        Description="护眼助手 - 蓝光过滤、亮度调节、20-20-20 休息提醒"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="护眼助手">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

<Page
    x:Class="EyeCare.Pages.BreakPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Stretch">
        <StackPanel Padding="32" Spacing="20" MaxWidth="720" HorizontalAlignment="Center">
            <StackPanel Spacing="4">
                <TextBlock Text="休息提醒" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="定时提醒你起身活动，放松眼睛和身体" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <ToggleSwitch x:Name="BreakSwitch" Header="启用休息提醒" Toggled="BreakSwitch_Toggled"/>
                    <ToggleSwitch x:Name="RuleSwitch" Header="使用 20-20-20 护眼法则" Toggled="RuleSwitch_Toggled"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="短休息" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <StackPanel Spacing="8">
                        <TextBlock Text="工作间隔（分钟）"/>
                        <NumberBox x:Name="WorkIntervalBox" Minimum="1" Maximum="120" SpinButtonPlacementMode="Compact" ValueChanged="WorkIntervalBox_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="休息时长（秒）"/>
                        <NumberBox x:Name="ShortBreakBox" Minimum="5" Maximum="600" SpinButtonPlacementMode="Compact" ValueChanged="ShortBreakBox_ValueChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="长休息" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="LongBreakSwitch" Header="启用长休息" Toggled="LongBreakSwitch_Toggled"/>
                    <StackPanel Spacing="8">
                        <TextBlock Text="长休息间隔（分钟）"/>
                        <NumberBox x:Name="LongIntervalBox" Minimum="30" Maximum="240" SpinButtonPlacementMode="Compact" ValueChanged="LongIntervalBox_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="长休息时长（秒）"/>
                        <NumberBox x:Name="LongBreakBox" Minimum="60" Maximum="1800" SpinButtonPlacementMode="Compact" ValueChanged="LongBreakBox_ValueChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="高级选项" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="PreBreakHeadsUpSwitch" Header="休息前 30 秒微提示（浮窗缓冲，支持推迟 5 分钟）" Toggled="PreBreakHeadsUpSwitch_Toggled"/>
                    <ToggleSwitch x:Name="AntiImpulsiveSwitch" Header="防冲动跳过模式（休息前 5 秒锁定跳过按钮）" Toggled="AntiImpulsiveSwitch_Toggled"/>
                    <ToggleSwitch x:Name="BreakSoundSwitch" Header="休息完成提示音（轻柔声音提醒恢复工作）" Toggled="BreakSoundSwitch_Toggled"/>
                    <ToggleSwitch x:Name="SmartPauseSwitch" Header="智能暂停（离开电脑时自动暂停计时）" Toggled="SmartPauseSwitch_Toggled"/>
                    <ToggleSwitch x:Name="EnforceSwitch" Header="强制休息（休息时全屏覆盖不可跳过）" Toggled="EnforceSwitch_Toggled"/>
                    <Button x:Name="BreakNowButton" Content="💆 立即休息" HorizontalAlignment="Left" Click="BreakNowButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
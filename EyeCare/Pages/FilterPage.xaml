<Page
    x:Class="EyeCare.Pages.FilterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Stretch">
        <StackPanel Padding="32" Spacing="20" MaxWidth="720" HorizontalAlignment="Center">
            <StackPanel Spacing="4">
                <TextBlock Text="蓝光与亮度" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="过滤有害蓝光，调节屏幕亮度，让眼睛更舒适" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <ToggleSwitch x:Name="BlueLightSwitch" Header="蓝光过滤（暖色调）" Toggled="BlueLightSwitch_Toggled"/>
                    <InfoBar IsOpen="True" Severity="Informational"
                             Title="蓝光过滤说明" Message="开启后会叠加柔和的暖色滤镜，降低蓝光刺激；屏幕亮度请使用下方独立的亮度调节开关。"/>
                    <StackPanel Spacing="8">
                        <TextBlock Text="色温" FontWeight="SemiBold"/>
                        <Slider x:Name="TempSlider" Minimum="1000" Maximum="10000" StepFrequency="100"
                                ValueChanged="TempSlider_ValueChanged"/>
                        <TextBlock x:Name="TempValueText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="过滤强度" FontWeight="SemiBold"/>
                        <Slider x:Name="StrengthSlider" Minimum="0" Maximum="1" StepFrequency="0.05"
                                ValueChanged="StrengthSlider_ValueChanged"/>
                        <TextBlock x:Name="StrengthValueText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <ToggleSwitch x:Name="BrightnessSwitch" Header="屏幕亮度调节" Toggled="BrightnessSwitch_Toggled"/>
                    <StackPanel Spacing="8">
                        <TextBlock Text="亮度" FontWeight="SemiBold"/>
                        <Slider x:Name="BrightnessSlider" Minimum="0.5" Maximum="1" StepFrequency="0.01"
                                ValueChanged="BrightnessSlider_ValueChanged"/>
                        <TextBlock x:Name="BrightnessValueText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
<Page
    x:Class="EyeCare.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Stretch">
        <StackPanel Padding="32" Spacing="20" MaxWidth="720" HorizontalAlignment="Center">
            <StackPanel Spacing="4">
                <TextBlock Text="护眼助手" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="保护视力，缓解数字眼疲劳" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <InfoBar IsOpen="True" Severity="Informational" IsClosable="True"
                     Title="20-20-20 护眼法则"
                     Message="每工作 20 分钟，远眺 20 英尺（约 6 米）外至少 20 秒。临床研究表明，定时休息是缓解数字眼疲劳最有效的手段（比单纯过滤蓝光更有价值）。"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="场景预设" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ProfileOfficeBtn" Grid.Column="0" HorizontalAlignment="Stretch" Padding="8,12" Click="ProfileOffice_Click">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="💻 办公" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="5000K · 90%" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProfileReadingBtn" Grid.Column="1" HorizontalAlignment="Stretch" Padding="8,12" Click="ProfileReading_Click">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="📖 阅读" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="4200K · 80%" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProfileSleepBtn" Grid.Column="2" HorizontalAlignment="Stretch" Padding="8,12" Click="ProfileSleep_Click">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="🌙 助眠" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="3200K · 65%" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProfileOriginalBtn" Grid.Column="3" HorizontalAlignment="Stretch" Padding="8,12" Click="ProfileOriginal_Click">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="🎬 原色" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="6500K · 还原" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="快捷开关" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="BlueLightToggle" Header="蓝光过滤" Toggled="BlueLightToggle_Toggled"/>
                    <ToggleSwitch x:Name="BrightnessToggle" Header="屏幕亮度调节" Toggled="BrightnessToggle_Toggled"/>
                    <ToggleSwitch x:Name="BreakToggle" Header="休息提醒" Toggled="BreakToggle_Toggled"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="工作计时" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="WorkStatusText" Text="已工作 0 分钟" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ProgressBar x:Name="WorkProgress" Minimum="0" Maximum="100" Value="0" Height="6"/>
                    <Button x:Name="BreakNowButton" Content="💆 现在休息一下" HorizontalAlignment="Left" Click="BreakNowButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- 今日健康用眼报告与近 7 天趋势 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="今日用眼报告" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                            <TextBlock Text="纯本地健康记录，帮助建立科学用眼节律" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Border x:Name="StreakBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="12" Padding="10,4">
                            <TextBlock x:Name="StreakText" Text="🔥 连续打卡 1 天" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="屏幕工作时长" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TodayScreenMinutesText" Text="0 分钟" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="蓝光保护时长" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TodayFilterMinutesText" Text="0 分钟" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="按时完成休息" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TodayBreaksText" Text="0 次" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="近 7 天屏幕工作趋势 (分钟)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid x:Name="ChartContainer" Height="110" ColumnSpacing="8">
                            <!-- 7 天图表柱动态生成 -->
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>